{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operatebench.org/schemas/executed-runtime-evidence-v1.schema.json",
  "title": "OperateBench ExecutedRuntimeEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "identity_manifest_digest_sha256",
    "operation_instance_id",
    "outcome",
    "decision_tape",
    "execution_record",
    "provider_binding",
    "runtime_evidence_digest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "operatebench.executed_runtime_evidence.v1"
    },
    "schema_version": {
      "const": 1
    },
    "identity_manifest_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "operation_instance_id": {
      "type": "string",
      "pattern": "^opinst_[0-9a-f]{32}(?![\\s\\S])"
    },
    "outcome": {
      "$ref": "episode-outcome-v2.schema.json"
    },
    "decision_tape": {
      "$ref": "decision-tape-v1.schema.json"
    },
    "execution_record": {
      "$ref": "execution-record-v1.schema.json"
    },
    "provider_binding": {
      "oneOf": [
        {
          "$ref": "provider-execution-binding-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_evidence_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    }
  },
  "description": "Canonical content record only; runtime authority and provider audit companions are process-local and absent. All cross-record and digest invariants are normative in IDENTITY_REPLAY_RFC.md."
}
