{
  "schema": "operatebench.clean_tracked_source_tree_golden.v1",
  "schema_version": 1,
  "algorithm": "operatebench.clean_tracked_source_tree.v1",
  "prefix_utf8": "operatebench.clean_tracked_source_tree.v1",
  "prefix_utf8_hex": "6f70657261746562656e63682e636c65616e5f747261636b65645f736f757263655f747265652e7631",
  "separator_byte_hex": "00",
  "enumeration_command": "git ls-tree -r -z --full-tree HEAD",
  "accepted_modes": [
    "100644",
    "100755",
    "120000"
  ],
  "max_path_utf8_bytes": 4096,
  "refusal_codes": [
    "dirty_tracked_content",
    "duplicate_path",
    "frame_length_overflow",
    "mode_observation_unavailable",
    "non_canonical_path",
    "out_of_order",
    "portable_path_collision",
    "staged_index_drift",
    "submodule_entry",
    "unreadable_bytes",
    "unsafe_path",
    "unsupported_mode"
  ],
  "precondition_vectors": [
    {
      "name": "staged_index_drift",
      "description": "`git diff-index --cached --quiet HEAD --` must exit zero; the index is compared with HEAD before the working tree so a staged change is never reported as ordinary dirt.",
      "refusal_code": "staged_index_drift",
      "probe": "git diff-index --cached --quiet HEAD --",
      "order": 1
    },
    {
      "name": "dirty_tracked_content",
      "description": "`git status --porcelain=v1 -z --untracked-files=all` must emit zero bytes; tracked/index/worktree changes and untracked non-ignored paths refuse, while Git continues to exclude ignored paths.",
      "refusal_code": "dirty_tracked_content",
      "probe": "git status --porcelain=v1 -z --untracked-files=all",
      "order": 2
    },
    {
      "name": "mode_observation_unavailable",
      "description": "On POSIX, explicit core.fileMode=false or core.symlinks=false refuses; true and unset use the enabled POSIX Git behavior. Non-POSIX execution refuses.",
      "refusal_code": "mode_observation_unavailable",
      "probe": "git config --get core.fileMode; git config --get core.symlinks",
      "order": 3
    }
  ],
