{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operatebench.org/schemas/episode-outcome-v2.schema.json",
  "title": "OperateBench EpisodeOutcomeV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "terminal_outcome",
    "replay_final",
    "started_at",
    "ended_at",
    "simulated_minutes",
    "invocations",
    "final_state",
    "final_state_digest_sha256",
    "trajectory",
    "trajectory_digest_sha256",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "operatebench.episode_outcome.v2"
    },
    "schema_version": {
      "const": 2
    },
    "status": {
      "oneOf": [
        {
          "enum": [
            "operation_deadlock",
            "operational_horizon_exhausted"
          ]
        },
        {
          "allOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
            },
            {
              "not": {
                "enum": [
                  "operation_deadlock",
                  "operational_horizon_exhausted"
                ]
              }
            }
          ]
        }
      ]
    },
    "terminal_outcome": {
      "oneOf": [
        {
          "allOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*(?![\\s\\S])"
            },
            {
              "not": {
                "enum": [
                  "operation_deadlock",
                  "operational_horizon_exhausted"
                ]
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "replay_final": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
    },
    "ended_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
    },
    "simulated_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "invocations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "final_state": {
      "type": "object",
      "maxProperties": 4096
    },
    "final_state_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "trajectory": {
      "type": "array",
      "maxItems": 4096
    },
    "trajectory_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "events": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_type",
          "actor_id",
          "at",
          "sequence",
          "payload",
          "triggers_agent",
          "caused_by",
          "disposition",
          "verdict_code"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z(?![\\s\\S])"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "payload": {
            "type": "object",
            "maxProperties": 4096
          },
          "triggers_agent": {
            "type": "boolean"
          },
          "caused_by": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "disposition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "verdict_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  },
  "description": "Core-generic canonical outcome. Cross-field terminal/status/replay_final and calendar/elapsed invariants are normative in IDENTITY_REPLAY_RFC.md."
}
