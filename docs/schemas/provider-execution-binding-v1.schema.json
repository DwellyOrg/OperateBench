{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operatebench.org/schemas/provider-execution-binding-v1.schema.json",
  "title": "OperateBench ProviderExecutionBindingV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "execution_run_id",
    "execution_ledger_version",
    "execution_ledger_digest_sha256",
    "provider",
    "api",
    "model",
    "settings_digest_sha256",
    "pricing_digest_sha256",
    "provider_calls",
    "attempts",
    "measured_cost_usd",
    "forfeited_reservation_usd",
    "input_tokens",
    "output_tokens",
    "decision_call_index"
  ],
  "properties": {
    "schema": {
      "const": "operatebench.provider_execution_binding.v1"
    },
    "schema_version": {
      "const": 1
    },
    "execution_run_id": {
      "type": "string",
      "pattern": "^exec_[0-9a-f]{32}(?![\\s\\S])"
    },
    "execution_ledger_version": {
      "enum": [2, 3]
    },
    "execution_ledger_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "provider": {
      "enum": ["openai", "anthropic", "xai", "mistral"]
    },
    "api": {
      "enum": ["responses", "messages", "chat_completions"]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "settings_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "pricing_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "provider_calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "measured_cost_usd": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?(?![\\s\\S])"
    },
    "forfeited_reservation_usd": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?(?![\\s\\S])"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decision_call_index": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"provider": {"const": "openai"}}},
      "then": {"properties": {"api": {"const": "responses"}}}
    },
    {
      "if": {"properties": {"provider": {"const": "anthropic"}}},
      "then": {"properties": {"api": {"const": "messages"}}}
    },
    {
      "if": {"properties": {"provider": {"const": "xai"}}},
      "then": {"properties": {"api": {"enum": ["chat_completions", "responses"]}}}
    },
    {
      "if": {"properties": {"provider": {"const": "mistral"}}},
      "then": {"properties": {"api": {"const": "chat_completions"}}}
    }
  ],
  "description": "Wire candidate only. Trusted construction requires a fresh successful complete scored execution-ledger-v2 or execution-ledger-v3 bundle audit; the process-local audit companion is neither wire nor digest content."
}
