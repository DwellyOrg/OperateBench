{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operatebench.org/schemas/correction-envelope-v1.schema.json",
  "title": "OperateBench CorrectionEnvelopeV1",
  "description": "Closed canonical envelope for an append-only OperateBench correction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "correction_id",
    "original_artifact_digest",
    "runtime_replay_report",
    "runtime_replay_report_digest",
    "old_evaluator_identity",
    "new_evaluator_identity",
    "new_grade",
    "new_grade_digest",
    "preregistration_or_correction_reference",
    "parent_correction_digest",
    "created_at",
    "provenance",
    "external_signature"
  ],
  "properties": {
    "schema_version": {
      "const": "operatebench.correction_envelope.v1"
    },
    "correction_id": {
      "$ref": "#/$defs/correctionId"
    },
    "original_artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "runtime_replay_report": {
      "$ref": "#/$defs/replayReport"
    },
    "runtime_replay_report_digest": {
      "$ref": "#/$defs/digest"
    },
    "old_evaluator_identity": {
      "$ref": "#/$defs/componentIdentity"
    },
    "new_evaluator_identity": {
      "$ref": "#/$defs/componentIdentity"
    },
    "new_grade": {
      "$ref": "#/$defs/evaluatorGrade"
    },
    "new_grade_digest": {
      "$ref": "#/$defs/digest"
    },
    "preregistration_or_correction_reference": {
      "$ref": "#/$defs/boundedReference"
    },
    "parent_correction_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/canonicalUtcTimestamp"
    },
    "provenance": {
      "$ref": "#/$defs/localProvenance"
    },
    "external_signature": {
      "oneOf": [
        {
          "$ref": "#/$defs/externalSignature"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "correctionId": {
      "type": "string",
      "pattern": "^corr_[0-9a-f]{32}$"
    },
    "namespacedName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "fieldPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?:/|(?:/[A-Za-z0-9._~-]+)+)$"
    },
    "boundedReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]{0,511}$"
    },
    "canonicalUtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "dependencyRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "compatible"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/namespacedName"
        },
        "compatible": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "pattern": "^>=[0-9]+\\.[0-9]+\\.[0-9]+,<=[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            {
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*@[1-9][0-9]*$"
            }
          ]
        }
      }
    },
    "componentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "schema_version",
        "content_digest_sha256",
        "owned_fields",
        "excludes",
        "requires"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/namespacedName"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "content_digest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "owned_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldPath"
          }
        },
        "excludes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fieldPath"
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependencyRequirement"
          }
        }
      }
    },
    "runtimeReplayVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_schema_valid",
        "execution_bundle_valid",
        "provider_attestation_status",
        "runtime_replay_valid",
        "finding_codes",
        "replayed_runtime_evidence_digest"
      ],
      "properties": {
        "artifact_schema_valid": {
          "type": "boolean"
        },
        "execution_bundle_valid": {
          "type": "boolean"
        },
        "provider_attestation_status": {
          "$ref": "#/$defs/namespacedName"
        },
        "runtime_replay_valid": {
          "type": "boolean"
        },
        "finding_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namespacedName"
          }
        },
        "replayed_runtime_evidence_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "historicalMatchDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_evaluator_identity",
        "evaluator_historical_match",
        "section_differences"
      ],
      "properties": {
        "historical_evaluator_identity": {
          "$ref": "#/$defs/componentIdentity"
        },
        "evaluator_historical_match": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "ERROR"
            }
          ]
        },
        "section_differences": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      }
    },
    "replayReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "runtime_verdict",
        "historical_match",
        "new_evaluator_grade_complete",
        "new_grade_digest"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "runtime_verdict": {
          "$ref": "#/$defs/runtimeReplayVerdict"
        },
        "historical_match": {
          "oneOf": [
            {
              "$ref": "#/$defs/historicalMatchDiagnostics"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_evaluator_grade_complete": {
          "type": "boolean"
        },
        "new_grade_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "commonOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "predicate_verdicts",
        "finding_codes"
      ],
      "properties": {
        "status": {
          "enum": ["SUCCESS", "FAILURE", "ERROR"]
        },
        "predicate_verdicts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/namespacedName"
          },
          "additionalProperties": {
            "enum": ["PASS", "FAIL", "ERROR"]
          }
        },
        "finding_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namespacedName"
          }
        }
      }
    },
    "evaluatorGrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_identity",
        "runtime_evidence_digest",
        "common_outcome",
        "result_vector",
        "grade_digest_sha256"
      ],
      "properties": {
        "evaluator_identity": {
          "$ref": "#/$defs/componentIdentity"
        },
        "runtime_evidence_digest": {
          "$ref": "#/$defs/digest"
        },
        "common_outcome": {
          "$ref": "#/$defs/commonOutcome"
        },
        "result_vector": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/namespacedName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "grade_digest_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "localProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "writer_identity",
        "source_revision",
        "source_tree_digest_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "operatebench.required_local_provenance.v1"
        },
        "writer_identity": {
          "$ref": "#/$defs/namespacedName"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^git_sha1_[0-9a-f]{40}$"
        },
        "source_tree_digest_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "externalSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "algorithm",
        "key_id",
        "signature_base64"
      ],
      "properties": {
        "schema_version": {
          "const": "operatebench.external_signature.v1"
        },
        "algorithm": {
          "enum": ["ed25519"]
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "signature_base64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
