{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operatebench.org/schemas/execution-record-v1.schema.json",
  "title": "OperateBench ExecutionRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "outcome_source",
    "model",
    "protocol_version",
    "max_output_tokens",
    "transport_calls",
    "retry_count",
    "attempts",
    "excluded",
    "exclusion_code",
    "exclusion_detail"
  ],
  "properties": {
    "schema": {
      "const": "operatebench.execution_record.v1"
    },
    "schema_version": {
      "const": 1
    },
    "outcome_source": {
      "enum": [
        "deterministic",
        "model",
        "recorded"
      ]
    },
    "model": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "protocol_version": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "max_output_tokens": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "transport_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retry_count": {
      "const": 0
    },
    "attempts": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invocation_index",
          "turn_index",
          "request_digest_sha256",
          "outcome",
          "fault"
        ],
        "properties": {
          "invocation_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "turn_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "request_digest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "outcome": {
            "enum": [
              "decided",
              "classified",
              "failed"
            ]
          },
          "fault": {
            "oneOf": [
              {
                "enum": [
                  "provider_transport",
                  "provider_protocol",
                  "provider_deadline",
                  "provider_budget"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "excluded": {
      "type": "boolean"
    },
    "exclusion_code": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "exclusion_detail": {
      "type": "string",
      "maxLength": 262144
    }
  },
  "description": "Closed execution record. Source/nullability, fault/outcome, exclusion, cardinality, and tape bindings are semantic invariants."
}
