{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operatebench.org/schemas/identity-field-census-v2.schema.json",
  "title": "OperateBench Identity Field Census v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "artifact_schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "operatebench.identity_field_census.v2"
    },
    "schema_version": {
      "const": 2
    },
    "artifact_schema": {
      "const": "operatebench.b1_card_contract.v2"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_path_pattern",
          "owner",
          "source_paths",
          "consumers",
          "nullability",
          "cardinality"
        ],
        "properties": {
          "field_path_pattern": {
            "type": "string",
            "pattern": "^/(?:[^/~*\r\n\u2028\u2029]|~0|~1)+(?:/(?:[^/~*\r\n\u2028\u2029]|~0|~1)+)*$(?![\\s\\S])",
            "maxLength": 1024
          },
          "owner": {
            "enum": [
              "card_schema_content",
              "operation_core_content",
              "semantic_scenario_content",
              "variant_content"
            ]
          },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:(?:src|docs|tests|tools)/(?!.*(?:^|/)(?:\\.{1,2}|)(?:/|$))[^\\\\\\u0000-\\u001f\\u007f\u2028\u2029]+|pyproject\\.toml|uv\\.lock)$(?![\\s\\S])"
            }
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$(?![\\s\\S])",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "nullability": {
            "enum": [
              "never",
              "explicit_null_allowed"
            ]
          },
          "cardinality": {
            "const": "exact"
          }
        }
      }
    }
  }
}
